  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Envelope yellow fill; one per decision (Postar, Seguir, Aceitar).",
      "html": "<button class=\"ds-btn-primary\">Seguir</button>",
      "css": ":host{--envelope:#ffc629;--envelope-deep:#f2b200;--on-envelope:#1b1f3b;--ink:#16181d;--ink-soft:#5f6470;--paper:#fafafa;--print:#fff;--line:#e7e7ea;--pencil:#e5262f;font-family:Archivo,system-ui,sans-serif}.ds-btn-primary{border:0;border-radius:.5rem;background:var(--envelope);color:var(--on-envelope);padding:.5rem 1.25rem;font:700 1rem/1.5 inherit;font-family:inherit;cursor:pointer;transition:background-color 150ms}.ds-btn-primary:hover{background:var(--envelope-deep)}.ds-btn-primary:focus-visible{outline:2px solid var(--on-envelope);outline-offset:2px}.ds-btn-primary:disabled{opacity:.5}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Line-gray fill for the alternative action (Entrar, Seguindo, Recusar).",
      "html": "<button class=\"ds-btn-secondary\">Seguindo</button>",
      "css": ":host{--envelope:#ffc629;--envelope-deep:#f2b200;--on-envelope:#1b1f3b;--ink:#16181d;--ink-soft:#5f6470;--paper:#fafafa;--print:#fff;--line:#e7e7ea;--pencil:#e5262f;font-family:Archivo,system-ui,sans-serif}.ds-btn-secondary{border:0;border-radius:.5rem;background:var(--line);color:var(--ink);padding:.5rem 1.25rem;font-weight:700;font-family:inherit;font-size:1rem;cursor:pointer;transition:opacity 150ms}.ds-btn-secondary:hover{opacity:.8}.ds-btn-secondary:focus-visible{outline:2px solid var(--ink);outline-offset:2px}"
    },
    {
      "name": "Destructive Button",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "Red outline to open account deletion; solid red to confirm.",
      "html": "<button class=\"ds-btn-danger\">Excluir minha conta</button>",
      "css": ":host{--envelope:#ffc629;--envelope-deep:#f2b200;--on-envelope:#1b1f3b;--ink:#16181d;--ink-soft:#5f6470;--paper:#fafafa;--print:#fff;--line:#e7e7ea;--pencil:#e5262f;font-family:Archivo,system-ui,sans-serif}.ds-btn-danger{border:2px solid var(--pencil);border-radius:.375rem;background:transparent;color:var(--pencil);padding:.5rem 1rem;font-weight:700;font-family:inherit;font-size:1rem;cursor:pointer}.ds-btn-danger:hover{background:var(--pencil);color:#fff}.ds-btn-danger:focus-visible{outline:2px solid var(--ink);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Labeled field on Paper; border goes Ink on focus, red on error.",
      "html": "<div class=\"ds-field\"><label for=\"ds-nick\">Nick</label><input id=\"ds-nick\" placeholder=\"seunick\"></div>",
      "css": ":host{--envelope:#ffc629;--envelope-deep:#f2b200;--on-envelope:#1b1f3b;--ink:#16181d;--ink-soft:#5f6470;--paper:#fafafa;--print:#fff;--line:#e7e7ea;--pencil:#e5262f;font-family:Archivo,system-ui,sans-serif}.ds-field{display:flex;flex-direction:column;max-width:20rem}.ds-field label{font-size:.875rem;font-weight:600;color:var(--ink-soft)}.ds-field input{margin-top:.25rem;border:1px solid var(--line);border-radius:.5rem;background:var(--paper);color:var(--ink);padding:.625rem .75rem;font:inherit;font-size:1rem;outline:none;transition:border-color 150ms}.ds-field input::placeholder{color:var(--ink-soft)}.ds-field input:focus{border-color:var(--ink)}.ds-field input[aria-invalid=true]{border-color:var(--pencil)}"
    },
    {
      "name": "Top Bar",
      "kind": "nav",
      "refersTo": "top-bar",
      "description": "Sticky translucent bar: wordmark left, icon tabs and avatar right.",
      "html": "<header class=\"ds-bar\"><span class=\"ds-word\">zivra</span><nav><a href=\"#\" class=\"ds-tab\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 7.5h12a1.5 1.5 0 0 1 1.5 1.5v9A1.5 1.5 0 0 1 18 19.5H6A1.5 1.5 0 0 1 4.5 18V9A1.5 1.5 0 0 1 6 7.5ZM7 4.5h10M4.5 15l4-3.5 3.5 3 2.5-2 5 3.5\"/></svg></a><a href=\"#\" class=\"ds-tab\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6.5 11h11v8.5h-11ZM8.5 11V8a3.5 3.5 0 0 1 7 0v3\"/></svg></a><span class=\"ds-av\">V</span></nav></header>",
      "css": ":host{--envelope:#ffc629;--envelope-deep:#f2b200;--on-envelope:#1b1f3b;--ink:#16181d;--ink-soft:#5f6470;--paper:#fafafa;--print:#fff;--line:#e7e7ea;--pencil:#e5262f;font-family:Archivo,system-ui,sans-serif}.ds-bar{display:flex;align-items:center;justify-content:space-between;height:3.5rem;padding:0 1rem;background:rgb(255 255 255/.9);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}.ds-word{font-weight:900;font-size:1.5rem;letter-spacing:-.02em;font-variation-settings:'wdth' 125;color:var(--ink)}.ds-bar nav{display:flex;align-items:center;gap:.25rem}.ds-tab{display:grid;place-items:center;padding:.5rem;border-radius:.5rem;color:var(--ink-soft);transition:background-color 150ms}.ds-tab[aria-current=page]{color:var(--ink)}.ds-tab:hover{background:rgb(22 24 29/.05)}.ds-tab:focus-visible{outline:2px solid var(--ink);outline-offset:2px}.ds-av{display:grid;place-items:center;width:2rem;height:2rem;margin-left:.25rem;border-radius:9999px;background:var(--envelope);color:var(--on-envelope);font-weight:700;font-size:.875rem}"
    },
    {
      "name": "Post Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Instagram-style feed card: header, media on black, loop like and comment, caption.",
      "html": "<article class=\"ds-post\"><header><span class=\"ds-av\">M</span><b>marina</b><span class=\"ds-soft\"> · há 2 horas</span></header><div class=\"ds-media\"></div><div class=\"ds-actions\"><button aria-label=\"Curtir\" aria-pressed=\"true\" class=\"ds-icon ds-liked\"><svg viewBox=\"0 0 24 24\" width=\"28\" height=\"28\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12.5 5.2c4.6.2 7.3 2.7 7 6.4-.3 4-4.2 7-8.6 6.9-4.2-.1-7-2.6-6.9-6 .1-3.7 3.6-6.6 8.3-6.9 1.4-.1 2.6.1 3.6.5\"/></svg></button><button aria-label=\"Comentários\" class=\"ds-icon\"><svg viewBox=\"0 0 24 24\" width=\"28\" height=\"28\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 6.5A1.5 1.5 0 0 1 6.5 5h11A1.5 1.5 0 0 1 19 6.5v8a1.5 1.5 0 0 1-1.5 1.5H11l-4 3.5V16h-.5A1.5 1.5 0 0 1 5 14.5Z\"/></svg></button></div><div class=\"ds-body\"><b>12 curtidas</b><p><b>marina</b> pôr do sol na laje</p><button class=\"ds-more\">Ver os 3 comentários</button></div></article>",
      "css": ":host{--envelope:#ffc629;--envelope-deep:#f2b200;--on-envelope:#1b1f3b;--ink:#16181d;--ink-soft:#5f6470;--paper:#fafafa;--print:#fff;--line:#e7e7ea;--pencil:#e5262f;font-family:Archivo,system-ui,sans-serif}.ds-post{max-width:500px;background:var(--print);color:var(--ink);border:1px solid var(--line);border-radius:.75rem;overflow:hidden}.ds-post header{display:flex;align-items:center;gap:.75rem;padding:.75rem 1rem}.ds-av{display:grid;place-items:center;width:2rem;height:2rem;border-radius:9999px;background:var(--envelope);color:var(--on-envelope);font-weight:700;font-size:.875rem}.ds-soft{color:var(--ink-soft)}.ds-media{aspect-ratio:4/5;background:linear-gradient(160deg,#3a4a5c,#c98a5a)}.ds-actions{display:flex;gap:.25rem;padding:.25rem .5rem 0}.ds-icon{border:0;background:none;color:var(--ink);padding:.5rem;border-radius:.5rem;cursor:pointer}.ds-icon:hover{background:rgb(22 24 29/.05)}.ds-icon:focus-visible{outline:2px solid var(--ink);outline-offset:2px}.ds-liked{color:var(--pencil)}.ds-body{padding:0 1rem 1rem}.ds-body p{margin:.25rem 0 0}.ds-more{border:0;background:none;padding:0;margin-top:.25rem;color:var(--ink-soft);font:inherit;cursor:pointer}"
    },
    {
      "name": "Profile Masonry",
      "kind": "custom",
      "description": "Pinterest-style columns; hover reveals counts; text-only posts as yellow tiles.",
      "html": "<ol class=\"ds-grid\"><li><button class=\"ds-tile\"><span class=\"ds-ph\" style=\"aspect-ratio:4/5\"></span><span class=\"ds-over\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12.5 5.2c4.6.2 7.3 2.7 7 6.4-.3 4-4.2 7-8.6 6.9-4.2-.1-7-2.6-6.9-6 .1-3.7 3.6-6.6 8.3-6.9 1.4-.1 2.6.1 3.6.5\"/></svg> 12</span></button></li><li><button class=\"ds-tile\"><span class=\"ds-text\">primeiro dia de praia do ano</span><span class=\"ds-over\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12.5 5.2c4.6.2 7.3 2.7 7 6.4-.3 4-4.2 7-8.6 6.9-4.2-.1-7-2.6-6.9-6 .1-3.7 3.6-6.6 8.3-6.9 1.4-.1 2.6.1 3.6.5\"/></svg> 4</span></button></li><li><button class=\"ds-tile\"><span class=\"ds-ph\" style=\"aspect-ratio:1\"></span><span class=\"ds-over\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12.5 5.2c4.6.2 7.3 2.7 7 6.4-.3 4-4.2 7-8.6 6.9-4.2-.1-7-2.6-6.9-6 .1-3.7 3.6-6.6 8.3-6.9 1.4-.1 2.6.1 3.6.5\"/></svg> 7</span></button></li><li><button class=\"ds-tile\"><span class=\"ds-ph\" style=\"aspect-ratio:3/4\"></span><span class=\"ds-over\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12.5 5.2c4.6.2 7.3 2.7 7 6.4-.3 4-4.2 7-8.6 6.9-4.2-.1-7-2.6-6.9-6 .1-3.7 3.6-6.6 8.3-6.9 1.4-.1 2.6.1 3.6.5\"/></svg> 2</span></button></li></ol>",
      "css": ":host{--envelope:#ffc629;--envelope-deep:#f2b200;--on-envelope:#1b1f3b;--ink:#16181d;--ink-soft:#5f6470;--paper:#fafafa;--print:#fff;--line:#e7e7ea;--pencil:#e5262f;font-family:Archivo,system-ui,sans-serif}.ds-grid{list-style:none;margin:0;padding:0;columns:3;column-gap:1rem;max-width:40rem}.ds-grid li{break-inside:avoid;margin-bottom:1rem}.ds-tile{position:relative;display:block;width:100%;padding:0;border:0;border-radius:.75rem;overflow:hidden;cursor:pointer;text-align:left}.ds-ph{display:block;background:linear-gradient(160deg,#5c6b4a,#d9b98a)}.ds-text{display:block;padding:1rem;background:var(--envelope);color:var(--on-envelope);font-weight:600;font-size:1.125rem;line-height:1.375}.ds-over{position:absolute;inset:auto 0 0 0;display:flex;align-items:center;gap:.25rem;padding:2rem .75rem .75rem;background:linear-gradient(to top,rgb(0 0 0/.6),transparent);color:#fff;font-weight:600;font-size:.875rem;opacity:0;transition:opacity 150ms}.ds-tile:hover .ds-over,.ds-tile:focus-visible .ds-over{opacity:1}.ds-tile:focus-visible{outline:2px solid var(--ink);outline-offset:2px}"
    },
    {
      "name": "Icon Chip",
      "kind": "chip",
      "refersTo": "icon-chip",
      "description": "44px yellow circle with an ink icon beside a short feature title.",
      "html": "<div class=\"ds-feat\"><span class=\"ds-chip\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6.5 11h11v8.5h-11ZM8.5 11V8a3.5 3.5 0 0 1 7 0v3\"/></svg></span><div><b>Perfil privado de verdade</b><p>Só entra quem você aceitar.</p></div></div>",
      "css": ":host{--envelope:#ffc629;--envelope-deep:#f2b200;--on-envelope:#1b1f3b;--ink:#16181d;--ink-soft:#5f6470;--paper:#fafafa;--print:#fff;--line:#e7e7ea;--pencil:#e5262f;font-family:Archivo,system-ui,sans-serif}.ds-feat{display:flex;gap:1rem;color:var(--ink)}.ds-chip{display:grid;place-items:center;flex-shrink:0;width:2.75rem;height:2.75rem;border-radius:9999px;background:var(--envelope);color:var(--on-envelope)}.ds-feat p{margin:.25rem 0 0;color:var(--ink-soft)}"
    }
  ],
  "narrative": {
    "northStar": "The Quiet Feed",
    "overview": "Zivra is a plain social layout that gets out of the way of people's photos. One shell serves every signed-in and public screen: a sticky translucent top bar with the wordmark and icon actions, a single centered content column, and a bottom tab bar on phones. There is no side menu. The feed reads like Instagram (one 500px column of cards); the profile reads like Pinterest (a masonry of prints in columns).\n\nThe surface is neutral: near-white paper, white cards, hairline gray borders, near-black ink, with a full dark scheme driven by `prefers-color-scheme`. Envelope yellow is the single accent and appears in small, deliberate doses: the primary action, the avatar fallback, the round icon chips, and text-only posts in the profile grid. Red is functional only (liked state, errors, destruction). Photos supply the rest of the color.",
    "keyCharacteristics": [
      "One shell, no sidebar: top bar plus centered column, bottom tabs under 640px.",
      "Neutral paper and white cards with 1px hairline borders; no decorative shadows.",
      "Envelope yellow is an accent, never a surface.",
      "Archivo throughout, with its width axis widened for the wordmark and hero.",
      "Content edge-to-edge on phones, carded with rounded corners from `sm` up."
    ],
    "rules": [
      {
        "name": "The Accent-Only Rule",
        "body": "Envelope yellow fills controls and small marks (primary button, avatar fallback, icon chip, text-post tile), never a page, section, header, or card background. If a screen reads as yellow, it is wrong.",
        "section": "colors"
      },
      {
        "name": "The Red Means State Rule",
        "body": "Pencil red only reports something: liked, error, limit reached, or destroy. It is never decoration or emphasis.",
        "section": "colors"
      },
      {
        "name": "The Weight Not Size Rule",
        "body": "Usernames, like counts and action words are set semibold at body size, like Instagram; hierarchy inside a card comes from weight, not from bigger type.",
        "section": "typography"
      },
      {
        "name": "The Hairline Rule",
        "body": "Separate with a 1px Line border or a tonal step. No drop shadows on cards, buttons, bars or sheets.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do route every screen except auth through the one shell: top bar, centered column, bottom tabs under 640px.",
      "Do keep Envelope Yellow to the primary button, avatar fallback, icon chips and text-post tiles, always with Envelope Ink text.",
      "Do separate surfaces with 1px Line borders and the Paper/Print tonal step.",
      "Do let content run edge to edge on phones and card it (12px radius, full border) from `sm` up.",
      "Do draw new icons on the 24px grid with 1.75 stroke and round caps, in `currentColor`.",
      "Do define every new color for both schemes, as the root tokens do."
    ],
    "donts": [
      "Don't add a side menu or a second navigation layout.",
      "Don't fill pages, sections, headers or cards with yellow.",
      "Don't use Pencil Red for anything but liked, error, limit and destructive states.",
      "Don't put drop shadows on cards, buttons or bars.",
      "Don't bring in an icon library or emoji as icons.",
      "Don't widen Archivo beyond normal width outside the wordmark, the hero headline and sheet titles."
    ]
  }
}
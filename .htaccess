<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /zivra/

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Laravel API (Sanctum SPA auth) and health check
    RewriteRule ^(api|sanctum|up)(/.*)?$ index.php [END]

    # Uploaded media
    RewriteRule ^storage/(.*)$ public/storage/$1 [END]

    # Next.js static export (web/out): home, exact files, then page.html
    RewriteRule ^$ web/out/index.html [END]
    RewriteCond %{DOCUMENT_ROOT}/zivra/web/out/$1 -f
    RewriteRule ^(.+)$ web/out/$1 [END]
    RewriteCond %{DOCUMENT_ROOT}/zivra/web/out/$1.html -f
    RewriteRule ^(.+?)/?$ web/out/$1.html [END]

    # Block direct access to project files (.env, vendor, composer.json, web sources...)
    RewriteCond %{REQUEST_URI} !/zivra/public/
    RewriteCond %{REQUEST_URI} !/zivra/web/out/
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [F,L]

    # Any single path segment is a profile: /zivra/{username} -> static profile page
    RewriteRule ^[A-Za-z0-9_-]+/?$ web/out/u.html [END]

    ErrorDocument 404 /zivra/web/out/404.html
</IfModule>

# Security headers for the static app (API responses set the same from Laravel).
# script-src needs 'unsafe-inline': the Next static export inlines its bootstrap scripts.
# ponytail: switch to hashes/nonces if the app moves off static export.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>
